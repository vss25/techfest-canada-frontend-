{
  "headers": [
    {
      "source": "/:path([Rr][Ss][Vv][Pp]/?)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/:path([Aa][Tt][Tt][Ee][Nn][Dd][Ii][Nn][Gg]/?)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "redirects": [
    {
      "source": "/first-timers",
      "destination": "/briefings",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/awards/nominations",
      "destination": "/awards"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
