{
  "git": {
    "deploymentEnabled": { "main": true, "**": false }
  },
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "techfest-canada-frontend.vercel.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|avif|svg|ico)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/app/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/app/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    },
    {
      "source": "/app/icons/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/app/(brand|splash|guide)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/hero-poster.jpg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/brochure-cover.jpg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/:path([Rr][Ss][Vv][Pp]/?)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/:path([Aa][Tt][Tt][Ee][Nn][Dd][Ii][Nn][Gg]/?)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/share/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/awards/jury-admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/awards/jury-admin/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/:private((?:admin|admin-login|auth-success|reset-password|app-login|complete-profile|survey|rate|linkedin|swag|share|tickets/checkout|exhibit/india-pavilion/pay|awards/jury-admin)(?:/.*)?)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/fact-sheet/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/checkin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/checkin/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/checkin/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    },
    {
      "source": "/:variant([Cc][Hh][Ee][Cc][Kk]-?[Ii][Nn]/?)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/:variant((?!checkin/)[Cc][Hh][Ee][Cc][Kk]-?[Ii][Nn])/:rest(.+)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/checkin-j0s8e5p4akvh",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/checkin-j0s8e5p4akvh/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/checkin-j0s8e5p4akvh/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "redirects": [
    { "source": "/awards-trophy-single.png", "destination": "/awards-trophy-single.webp", "permanent": true },
    { "source": "/venue1.jpg", "destination": "/venue1.webp", "permanent": true },
    { "source": "/venue3.jpg", "destination": "/venue3.avif", "permanent": true },
    { "source": "/venue5.jpg", "destination": "/venue5.webp", "permanent": true },
    { "source": "/toronto-skyline.png", "destination": "/toronto-skyline.jpg", "permanent": true },
    {
      "source": "/checkin",
      "destination": "/checkin/",
      "permanent": true
    },
    {
      "source": "/:variant((?!checkin/$)[Cc][Hh][Ee][Cc][Kk]-?[Ii][Nn]/?)",
      "destination": "/checkin/",
      "permanent": true
    },
    {
      "source": "/:variant((?!checkin/)[Cc][Hh][Ee][Cc][Kk]-?[Ii][Nn])/:rest(.+)",
      "destination": "/checkin/:rest",
      "permanent": true
    },
    {
      "source": "/checkin-j0s8e5p4akvh",
      "destination": "/checkin/",
      "permanent": true
    },
    {
      "source": "/checkin-j0s8e5p4akvh/:rest((?!sw\\.js$).*)",
      "destination": "/checkin/",
      "permanent": true
    },
    {
      "source": "/:legacy((?:first-timers|briefings|dashboard|kyc)/?)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:legacy(on-demand/?)",
      "destination": "/resources",
      "permanent": true
    },
    {
      "source": "/awards/:legacy(nominations/?)",
      "destination": "/awards",
      "permanent": true
    },
    {
      "source": "/speakers/-:slug([^/]+)",
      "destination": "/speakers/:slug",
      "permanent": true
    },
    {
      "source": "/speakers/:slug([^/]*[^/-])-",
      "destination": "/speakers/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/stay-updated", "destination": "/stay-updated/index.html" },
    { "source": "/awards", "destination": "/awards/index.html" },
    { "source": "/speakers", "destination": "/speakers/index.html" },
    { "source": "/agenda", "destination": "/agenda/index.html" },
    { "source": "/programme", "destination": "/programme/index.html" },
    { "source": "/venue", "destination": "/venue/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/sponsor", "destination": "/sponsor/index.html" },
    { "source": "/partners2026", "destination": "/partners2026/index.html" },
    { "source": "/sponsors", "destination": "/sponsors/index.html" },
    { "source": "/exhibit", "destination": "/exhibit/index.html" },
    { "source": "/exhibit/india-pavilion", "destination": "/exhibit/india-pavilion/index.html" },
    { "source": "/organizers", "destination": "/organizers/index.html" },
    { "source": "/media", "destination": "/media/index.html" },
    { "source": "/volunteer", "destination": "/volunteer/index.html" },
    { "source": "/brochures", "destination": "/brochures/index.html" },
    { "source": "/resources", "destination": "/resources/index.html" },
    { "source": "/tickets", "destination": "/tickets/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/app/index.html"
    },
    {
      "source": "/checkin/(.*)",
      "destination": "/checkin/index.html"
    },
    {
      "source": "/get-app",
      "destination": "/get-app/index.html"
    },
    {
      "source": "/get-app/",
      "destination": "/get-app/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/spa.html"
    }
  ]
}
