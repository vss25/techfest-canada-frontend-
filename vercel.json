{
  "headers": [
    {
      "source": "/rsvp",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "redirects": [
    {
      "source": "/first-timers",
      "destination": "/briefings",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/awards/nominations",
      "destination": "/awards"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
